# Default fallback password for accounts in accounts.txt with no password specified
DEFAULT_ACCOUNT_PASSWORD=YourPasswordHere123!

# Antigravity Portal / OAuth target URL
ANTIGRAVITY_PORTAL_URL=https://antigravity.google/docs

# Browser Automation Settings
BROWSER_HEADLESS=false
PAGE_TIMEOUT_SECONDS=30
ACTION_DELAY_SECONDS=2

# Persistent Profile caching to maintain sessions
PERSISTENT_PROFILES=true
PROFILES_DIR=chrome_profiles

# Token & Session Extraction (for 9router or API proxies)
EXTRACT_TOKENS=true
TOKENS_OUTPUT_JSON=verified_tokens.json
TOKENS_OUTPUT_TXT=verified_tokens.txt
